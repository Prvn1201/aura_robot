<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="lidar_sensor" params="x y z">
    <link name="laser_link">
      <!-- Main LiDAR Body -->
      <visual>
        <geometry>
          <cylinder radius="0.02" length="0.03"/>
        </geometry>
        <material name="lidar_orange"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.02" length="0.03"/>
        </geometry>
      </collision>
      
      <!-- Cosmetic mounting post (menyambungkan LiDAR ke bumbung) -->
      <visual>
        <origin xyz="0 0 -0.0225" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.006" length="0.015"/>
        </geometry>
        <material name="steering_dark"/>
      </visual>
      
      <xacro:cylinder_inertia mass="0.10" radius="0.02" length="0.03"/>
    </link>

    <joint name="laser_joint" type="fixed">
      <parent link="base_link"/>
      <child link="laser_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

</robot>
