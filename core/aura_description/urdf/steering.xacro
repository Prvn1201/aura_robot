<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Steering knuckle macro - only used for the two FRONT wheels.
    Creates a small revolute (position-controlled) link that the wheel
    macro then attaches to, matching the TF tree from Step 4:
      base_link -> front_*_steering -> front_*_wheel

    params:
      name    - prefix, e.g. "front_left"
      x y z   - steering joint origin relative to base_link
  -->
  <xacro:macro name="steering_wheel" params="name x y z">

    <link name="${name}_steering">
      <visual>
        <geometry>
          <cylinder radius="0.008" length="0.02"/>
        </geometry>
        <material name="steering_dark"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.008" length="0.02"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia mass="${steering_mass}" radius="0.008" length="0.02"/>
    </link>

    <joint name="${name}_steering_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${name}_steering"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-steering_limit}" upper="${steering_limit}"
             effort="10.0" velocity="4.0"/>
      <dynamics damping="0.001" friction="0.001"/>
    </joint>

    <!-- the wheel hangs off the steering knuckle, not off base_link directly -->
    <xacro:wheel name="${name}" parent="${name}_steering" x="0" y="0" z="0"/>

  </xacro:macro>

</robot>
